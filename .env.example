# Runtime
NODE_ENV=development
DATABASE_URL=postgresql://alp:alp@localhost:5432/alp
REDIS_URL=redis://localhost:6379

# Chain: do not use a production private key in a local .env file.
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
DEPLOYER_PRIVATE_KEY=
SAFE_ADDRESS=
TIMELOCK_ADDRESS=

# Addresses written by deployment scripts; never hard-code token addresses in apps.
NEXT_PUBLIC_ADDRESS_BOOK_PATH=deployments/bsc-testnet.json
ADDRESS_BOOK_PATH=deployments/bsc-testnet.json

# API / auth
API_PORT=4000
INDEXER_START_BLOCK=0
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000
ADMIN_JWT_SECRET=replace-with-a-32-byte-minimum-secret
